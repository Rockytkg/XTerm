{{! Tauri Handlebars 桌面文件模板,用于 deb / rpm 打包;可用变量见 tauri.conf.json bundle.linux.*.desktopTemplate }}
[Desktop Entry]
Type=Application
Name={{name}}
GenericName=Terminal Workspace
{{#if comment}}Comment={{comment}}{{/if}}
Exec={{exec}}
Icon={{icon}}
Terminal=false
Categories=Network;RemoteAccess;TerminalEmulator;System;
StartupWMClass=XTerm
