{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XTerm",
  "version": "1.0.1",
  "identifier": "com.liushicong.xterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XTerm",
        "width": 1180,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "devtools": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; media-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ssh", "telnet"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/main.desktop"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": ["en-US", "zh-CN"],
        "fragmentPaths": ["windows/remove-data.wxs"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
