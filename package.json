{
  "name": "xterm",
  "private": true,
  "version": "1.0.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "pnpm format:check && pnpm lint && pnpm test",
    "format": "prettier --write \"**/*.{js,scss}\" && eslint \"**/*.vue\" --fix && stylelint \"**/*.{scss,vue}\" --fix && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"**/*.{js,scss}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "eslint . --max-warnings=0 && stylelint \"**/*.{scss,vue}\" && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{scss,vue}\" --fix",
    "test": "node --test",
    "preview": "vite preview",
    "tauri": "tauri dev --features mcp-bridge --config src-tauri/tauri.mcp.conf.json -- --",
    "release": "tauri build",
    "release:debug": "tauri build --debug"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.5",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lucide/vue": "^1.47.0",
    "@novnc/novnc": "^1.7.0",
    "@open-file-viewer/core": "^0.1.47",
    "@open-file-viewer/vue": "^0.1.47",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.3",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@unocss/reset": "^66.10.5",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.3",
    "gsap": "^3.15.0",
    "pako": "^3.0.2",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "prettier": "^3.9.8",
    "prismjs": "^1.30.0",
    "reka-ui": "^2.10.4",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.51.2",
    "unocss": "^66.10.5",
    "vite": "^8.3.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
