{
  "name": "xterm",
  "private": true,
  "version": "1.0.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "pnpm format:check && pnpm lint && pnpm test",
    "format": "prettier --write \"**/*.{js,scss}\" && eslint \"**/*.vue\" --fix && stylelint \"**/*.{scss,vue}\" --fix && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"**/*.{js,scss}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "eslint . --max-warnings=0 && stylelint \"**/*.{scss,vue}\" && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{scss,vue}\" --fix",
    "test": "node --test",
    "preview": "vite preview",
    "tauri": "tauri dev -- --",
    "release": "tauri build",
    "release:debug": "tauri build --debug"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.5",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
