    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lucide/vue": "^1.48.0",
    "@novnc/novnc": "^1.7.0",
    "@open-file-viewer/core": "^0.1.48",
    "@open-file-viewer/vue": "^0.1.48",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.4.0",
    "@tauri-apps/plugin-deep-link": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@unocss/reset": "^66.10.5",
    "@xterm/addon-image": "^0.10.0-beta.301",
    "@xterm/addon-ligatures": "^0.11.0-beta.301",
    "@xterm/addon-progress": "^0.3.0-beta.301",
    "@xterm/addon-search": "^0.17.0-beta.301",
    "@xterm/addon-unicode11": "^0.10.0-beta.301",
    "@xterm/addon-web-links": "^0.13.0-beta.301",
    "@xterm/addon-webgl": "^0.20.0-beta.300",
    "@xterm/xterm": "^6.1.0-beta.304",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.3",
    "pako": "^3.0.2",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "prismjs": "^1.30.0",
    "reka-ui": "^2.10.5",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.51.2",
